{
    "type": "object",
    "required": [
        "port", "op_host", "op_auth"
    ],
    "additionalProperties" : {
        "type" : "string"
    },
    "properties": {
        "port": {
            "type": "number"
        },
        "op_host": {
            "type": "string"
        },
        "op_auth": {
            "type": "object",
            "required": [ "username", "password" ],
            "properties": {
                "username": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "projects": {
            "type": "array",
            "format": "tabs-top",
            "items": {
                "type": "object",
                "headerTemplate": "{{ self.name }}",
                "required": [
                    "name",
                    "op_id"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "op_id": {
                        "type": "number"
                    },
                    "git_id": {
                        "type": "number"
                    },
                    "webhook": {
                        "type": "string"
                    },
                    "tag_by_status":
                    {
                        "type" : "object",
                        "additionalProperties": { "type" : "array", "items" : { "type" : "number"} }
                    }
                },
                "options" : { "containerAttributes" : { "data-container": "project" }}
            }
        },
        "rules" : {
            "type" : "array",
            "format": "table",
            "items" : {
                "type": "object",
                "headerTemplate": "{{status}}",
                "watch" : {
                    "status" : "status"
                },
                "properties" : {
                    "status_from" : { "type" : "number" },
                    "status" : { "type" : [ "number", "array" ], "items" : { "type" : "number" } },
                    "template" : {"type" : "string" }
                }
            }
        },
        "op_status_closed": {
            "type": "number"
        },
        "git_host": {
            "type": "string"
        },
        "users": {
            "type": "object",
            "format":"table",
            "required": [],
            "title" : "Users",
            "description" : "Users dictionary",
            "additionalProperties": {
                "type": [
                    "object",
                    "string"
                ],
                "required": [],
                "additionalProperties": {
                    "type" : "string"
                }
            }
        },
        "admin_key": {
            "type": "string"
        }
    }
}